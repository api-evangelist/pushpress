{
  "opencollection": "1.0.0",
  "info": {
    "name": "PushPress Platform ApiKeys Enrollments API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "API-KEY",
      "value": "{{API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Enrollments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List plan enrollments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pushpress.com/v3/enrollments",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination."
              }
            ]
          },
          "docs": "Lists customer enrollments in membership plans, with pagination."
        },
        {
          "info": {
            "name": "Get plan enrollment details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pushpress.com/v3/enrollments/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the resource."
              }
            ]
          },
          "docs": "Retrieves a single plan enrollment by UUID."
        }
      ]
    }
  ],
  "bundled": true
}