{
  "opencollection": "1.0.0",
  "info": {
    "name": "PushPress Platform ApiKeys Plans API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "API-KEY",
      "value": "{{API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Plans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get plan details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pushpress.com/v3/plans/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The identifier of the resource."
              }
            ]
          },
          "docs": "Retrieves a single membership / billing plan by ID."
        }
      ]
    }
  ],
  "bundled": true
}