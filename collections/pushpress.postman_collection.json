{
  "info": {
    "name": "PushPress Platform API",
    "description": "REST API for the PushPress gym/fitness management platform. Base URL https://api.pushpress.com/v3. Authenticated with an API key in the API-KEY header; every request is scoped to a gym location with a company-id header. Paths and methods grounded in the official @pushpress/pushpress SDK and public API reference; schemas modeled by API Evangelist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "API-KEY",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.pushpress.com/v3",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Company",
      "item": [
        {
          "name": "Get company details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "company-id",
                "value": "{{companyId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/company",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "company"
              ]
            },
            "description": "Retrieves details for the company (gym) the API key is scoped to."
          }
        }
      ]
    },
